{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm ci && npm run build",
  "functions": {
    "app/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{node_modules/**,src/**,public/**,tests/**,scripts/**,.venv/**,.github/**,**/__pycache__/**}"
    }
  },
  "crons": [
    { "path": "/api/cron/monitors", "schedule": "30 3 * * *" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
