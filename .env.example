# Copy to .env for local development. On Vercel, set these under Settings → Environment Variables.

# ---- Required on Vercel ----
# MongoDB Atlas connection string (Atlas → Connect → Drivers). Leave empty locally to use a throwaway in-memory database.
MONGODB_URI=
MONGODB_DB=ghosttrace
# Signs login tokens: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---- GitHub scanning (strongly recommended) ----
# https://github.com/settings/tokens → classic token, no scopes needed for public repos. 60 requests/hour without it.
GITHUB_TOKEN=

# ---- Email alerts (any SMTP provider; for Gmail use an app password) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GhostTrace <alerts@yourdomain.com>

# ---- Scheduled monitoring on Vercel (Vercel Cron sends this as a Bearer token) ----
CRON_SECRET=

# ---- AI Security Analyst (Groq) ----
# Free key at https://console.groq.com/keys. Leave empty to turn the AI features off. Calls only ever happen on the
# server, and every secret is redacted before anything is sent. Test it with: npm run ai:check
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Per-user limits (AI calls only; saved answers are free)
# AI_FINDING_LIMIT_PER_10MIN=30
# AI_PR_LIMIT_PER_HOUR=10
# AI_POSTURE_LIMIT_PER_HOUR=6
# AI_DAILY_LIMIT=200

# ---- Optional ----
# Have I Been Pwned API key (paid). Without it GhostTrace uses the free XposedOrNot breach database.
HIBP_API_KEY=
